# Postgres (Railway ou Supabase)
DATABASE_URL="postgresql://usuario:senha@host:5432/lysor?schema=public"
DIRECT_URL="postgresql://usuario:senha@host:5432/lysor?schema=public"

# Autenticação
# Não há segredo a configurar: a sessão é uma linha na tabela `sessao` e o
# cookie carrega um token aleatório opaco, não um JWT assinado. Nada para
# vazar em variável de ambiente, e revogar alguém é apagar a linha.
#
# O primeiro usuário se cria pelo terminal, uma vez:
#   npm run usuario -- --nome "Ana Paula" --email ana@lysor.com.br --perfil ADMIN

# Storage S3-compatível (anexos: cupom, NF, comprovante)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
